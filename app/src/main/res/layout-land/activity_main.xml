<?xml version="1.0" encoding="utf-8"?>
<LinearLayout    xmlns:android="http://schemas.android.com/apk/res/android"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/grey">
<!--
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CASIO"
        android:textSize="25sp"
        android:fontFamily="@font/calculator"
        android:textColor="@color/white"/> -->
    <TextView
        android:id="@+id/pantalla"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:background="@color/verde_gris"
        android:gravity="center_vertical|end"
        android:padding="12dp"
        android:text="0"
        android:fontFamily="@font/calculator"
        android:textColor="#15171A"
        android:textSize="35sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_weight="1.8"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:textAlignment="center">
        <Button
            android:id="@+id/memoria1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="M-"
            android:textSize="30sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/gris_azul"
            android:textColor="@color/blue"/>
        <Button
            android:id="@+id/memoria2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="M+"
            android:textSize="30sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/gris_azul"
            android:textColor="@color/blue"/>
        <Button
            android:id="@+id/memoria3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="Mc"
            android:textSize="30sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/gris_azul"
            android:textColor="@color/blue"/>
        <Button
            android:id="@+id/memoria4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Mr"
            android:textSize="30sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/gris_azul"
            android:textColor="@color/blue"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_weight="1.8"
        android:orientation="horizontal"
        android:layout_marginTop="5dp">
        <Button
            android:id="@+id/Reiniciar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="AC"
            android:textSize="25sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/gris_medio"
            android:textColor="@color/white"/>
        <Button
            android:id="@+id/Boton1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="Del"
            android:textSize="25sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/gris_medio"
            android:textColor="@color/white"/>
        <Button
            android:id="@+id/porcentaje"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="%"
            android:textSize="24sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/gris_medio"
            android:textColor="@color/white"/>
        <Button
            android:id="@+id/division"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="÷"
            android:textSize="25sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/gris_medio"
            android:textColor="@color/white"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_weight="1.8"
        android:orientation="horizontal"
        android:layout_marginTop="5dp">
        <Button
            android:id="@+id/nueve"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="9"
            android:textSize="25sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/grisaceo"
            android:textColor="@color/white"/>
        <Button
            android:id="@+id/ocho"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="8"
            android:textSize="25sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/grisaceo"
            android:textColor="@color/white"/>
        <Button
            android:id="@+id/siete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="7"
            android:textSize="25sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/grisaceo"
            android:textColor="@color/white"/>
        <Button
            android:id="@+id/multiplica"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="x"
            android:textSize="20sp"
            android:backgroundTint="@color/gris_medio"
            android:textColor="@color/white"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_weight="1.8"
        android:orientation="horizontal"
        android:layout_marginTop="5dp">
        <Button
            android:id="@+id/seis"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="6"
            android:textSize="25sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/grisaceo"
            android:textColor="@color/white"/>
        <Button
            android:id="@+id/cinco"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="5"
            android:textSize="25sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/grisaceo"
            android:textColor="@color/white"/>
        <Button
            android:id="@+id/quatro"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="4"
            android:textSize="25sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/grisaceo"
            android:textColor="@color/white"/>
        <Button
            android:id="@+id/menos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="-"
            android:textSize="30sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/gris_medio"
            android:textColor="@color/white"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_weight="1.8"
        android:orientation="horizontal"
        android:layout_marginTop="5dp">
        <Button
            android:id="@+id/tres"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="3"
            android:textSize="25sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/grisaceo"
            android:textColor="@color/white"/>
        <Button
            android:id="@+id/dos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="2"
            android:textSize="25sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/grisaceo"
            android:textColor="@color/white"/>
        <Button
            android:id="@+id/uno"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="1"
            android:textSize="25sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/grisaceo"
            android:textColor="@color/white"/>
        <Button
            android:id="@+id/suma"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="+"
            android:textSize="30sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/gris_medio"
            android:textColor="@color/white"/>
    </LinearLayout>
    <LinearLayout
    android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_weight="1.8"
    android:orientation="horizontal"
    android:layout_marginTop="5dp">
        <Button
            android:id="@+id/zero"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:layout_marginEnd="3dp"
            android:text="0"
            android:textSize="25sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/grisaceo"
            android:textColor="@color/white"/>
        <Button
            android:id="@+id/coma"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text=","
            android:textSize="30sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/grisaceo"
            android:textColor="@color/white"/>
        <Button
            android:id="@+id/igual"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="="
            android:textSize="30sp"
            android:fontFamily="@font/calculator"
            android:backgroundTint="@color/azul"
            android:textColor="@color/white"/>
    </LinearLayout>

</LinearLayout>